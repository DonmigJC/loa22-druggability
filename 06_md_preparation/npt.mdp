; NPT equilibration - 2 ns, RESTRAINED   (FIX 1, FIX 6)
define                   = -DPOSRES -DPOSRES_LIG
integrator               = md
nsteps                   = 1000000
dt                       = 0.002
nstxout-compressed       = 5000
nstenergy                = 1000
nstlog                   = 1000
continuation             = yes
constraint_algorithm     = lincs
constraints              = h-bonds
lincs_iter               = 1
lincs_order              = 4
nstlist                  = 10
; FIX 2 - CHARMM36 requires force-switched LJ, no DispCorr
cutoff-scheme            = Verlet
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.16
rcoulomb                 = 1.2
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0
rvdw                     = 1.2
DispCorr                 = no
tcoupl                   = V-rescale
tc-grps                  = Protein_LIG Water_and_ions
tau_t                    = 0.1     0.1
ref_t                    = 310     310
pcoupl                   = C-rescale
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5
refcoord_scaling         = com
pbc                      = xyz
gen_vel                  = no
