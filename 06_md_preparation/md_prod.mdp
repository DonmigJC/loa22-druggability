; Production - 100 ns, unrestrained
integrator               = md
nsteps                   = 50000000
dt                       = 0.002
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstxout-compressed       = 5000
compressed-x-grps        = System
nstenergy                = 5000
nstlog                   = 5000
continuation             = yes
constraint_algorithm     = lincs
constraints              = h-bonds
lincs_iter               = 1
lincs_order              = 4
nstlist                  = 20
; FIX 2 - CHARMM36 requires force-switched LJ, no DispCorr
cutoff-scheme            = Verlet
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.16
rcoulomb                 = 1.2
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0
rvdw                     = 1.2
DispCorr                 = no
tcoupl                   = V-rescale
tc-grps                  = Protein_LIG Water_and_ions
tau_t                    = 0.1     0.1
ref_t                    = 310     310
pcoupl                   = C-rescale
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5
pbc                      = xyz
gen_vel                  = no
